# =============================================================
# EA QMS — Docker Compose configuration
#
# For deploy/docker/docker-compose.yml only. PostgreSQL runs as a
# container in this stack, so there is no DB_URL here — Compose builds
# the connection strings for the API and the migrator from the three
# values below.
#
# For running the API on bare metal (go run .), use the .env.example in
# the repository root instead; that one has DB_URL.
#
# Copy this file to .env and change JWT_SECRET before use.
# =============================================================

# -------------------------------------------------------------
# Database — created on first boot with these credentials
# -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ea_qms

# Connection pool ceiling per API process. Each instance keeps its own
# pool, so the real load on Postgres is (instances x this value). Must
# stay well under the server's max_connections, which defaults to 100.
DB_MAX_OPEN_CONNS=25

# -------------------------------------------------------------
# Application runtime
# -------------------------------------------------------------
PLATFORM=dev

# ⚠ CHANGE THIS. It signs every access token, so anyone who knows it can
# mint a token for any user. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=replace-this-before-you-run-anything

# The browser origin allowed to call the API. Must match exactly —
# scheme, host and port. http://localhost:5173 does not cover
# http://127.0.0.1:5173. Getting it wrong looks like the API being down:
# Postman and curl keep working, the browser silently blocks everything.
ALLOWED_ORIGINS=http://localhost:5173

# -------------------------------------------------------------
# Argon2id password hashing
# -------------------------------------------------------------
ARGON2ID_MEMORY=65536
ARGON2ID_ITERATIONS=3
ARGON2ID_PARALLELISM=2
ARGON2ID_SALT_LENGTH=16
ARGON2ID_KEY_LENGTH=32
